# youssefjalloul.com on Hostinger (LiteSpeed/Apache)
Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
RewriteEngine On
# Force HTTPS and the bare domain
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://youssefjalloul.com%{REQUEST_URI} [L,R=301]
# /index.html -> /
RewriteRule ^index\.html$ / [L,R=301]
</IfModule>

AddType text/plain .txt
AddType application/json .json
AddType image/webp .webp
AddType font/woff2 .woff2
AddType application/manifest+json .webmanifest
AddType image/x-icon .ico
AddCharset utf-8 .html .css .js .txt .json .xml

<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript text/plain application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType text/html "access plus 0 seconds"
ExpiresByType text/css "access plus 7 days"
ExpiresByType application/javascript "access plus 7 days"
ExpiresByType image/webp "access plus 30 days"
ExpiresByType image/png "access plus 30 days"
ExpiresByType image/jpeg "access plus 30 days"
ExpiresByType image/svg+xml "access plus 30 days"
ExpiresByType font/woff2 "access plus 1 year"
ExpiresByType image/x-icon "access plus 30 days"
ExpiresByType application/manifest+json "access plus 7 days"
</IfModule>

<IfModule mod_headers.c>
Header set X-Content-Type-Options "nosniff"
Header set Referrer-Policy "strict-origin-when-cross-origin"
Header set X-Frame-Options "SAMEORIGIN"
Header always set Strict-Transport-Security "max-age=31536000"
Header set Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
# CSP (generated by build.py)
Header set Content-Security-Policy-Report-Only "script-src 'sha256-5sCxlt4gvQc8uyjQZTHF0q+sux66+0Zmsj192NmaThE=' 'sha256-6AtnQsGP/RMgQt9lbYVV01emmxu6yXWEZIPre48Fk8w=' 'sha256-CWXFq1DMCYmIzxFTXb+IoCpZiiiMeDgRo+6Arv0KLDA=' 'sha384-/7xj40YAOspETB5yZJzrlevngyw0B2o2lO07FQ13REYdPqjAV/qGJUdriuBq3SQk' 'sha384-dJOnizYu7Zju89ir8l9cjheJ7kVDwgViJ9nXLvLz45ZDORgK7B2Y0pZ53UOU83fd' 'strict-dynamic' 'unsafe-inline' https: 'report-sample'; object-src 'none'; base-uri 'none'; frame-ancestors 'self'"
</IfModule>
